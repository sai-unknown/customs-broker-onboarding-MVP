# Copy to .env in project root before running docker compose up

# Required: generate with `openssl rand -hex 32`
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-characters-long

# Database
POSTGRES_USER=broker
POSTGRES_PASSWORD=broker_secret_change_me
POSTGRES_DB=customs_broker

# Public URL of the frontend (used for CORS)
FRONTEND_URL=http://localhost

# Set to true only if open broker registration is intended
ALLOW_PUBLIC_REGISTRATION=false

# Host port for the web container
WEB_PORT=80
