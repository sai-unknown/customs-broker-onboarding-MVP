# Backend environment variables
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/customs_broker

# JWT signing secret (minimum 32 characters)
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# Comma-separated allowed frontend origins
FRONTEND_URL=http://localhost:5173

# Set to "false" to disable public broker registration in production
ALLOW_PUBLIC_REGISTRATION=true

# Database pool size (optional)
DB_POOL_MAX=20

# Enable SSL for managed PostgreSQL in production (optional)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
